[Unit]
Description=dohuyk.dev backend (apps/server)
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/DoHyuk.dev/apps/server
ExecStart=/usr/bin/node src/index.ts
Restart=on-failure
RestartSec=5
Environment=NODE_ENV=production
Environment=PORT=4000

[Install]
WantedBy=multi-user.target
