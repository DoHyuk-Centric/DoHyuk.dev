[Unit]
Description=dohuyk.dev frontend (apps/web, Next.js)
After=network.target dohuyk-server.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/DoHyuk.dev/apps/web
ExecStart=/usr/bin/pnpm start
Restart=on-failure
RestartSec=5
Environment=NODE_ENV=production
Environment=PORT=3000

[Install]
WantedBy=multi-user.target
